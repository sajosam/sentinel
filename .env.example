# SentinelOS Environment Configuration

# Server Settings
APP_NAME="SentinelOS Security Service"
ENV="development"
HOST="127.0.0.1"
PORT=8000
DATABASE_URL="sqlite:///./sentinel.db"

# Meta Model API (OpenAI-compatible). With no key, SentinelOS runs its deterministic offline engine.
PROD_MODEL_PROVIDER="meta"
PROD_MODEL_BASE_URL="https://api.meta.ai/v1"
PROD_MODEL_API_KEY="your_meta_model_api_key_here"
# or set: META_API_KEY="..."
PROD_PLANNING_MODEL="muse-spark-1.3"      # Muse Spark: investigation planning
PROD_REASONING_MODEL="muse-wonder-1.0"    # Muse Wonder: ThreatLens, exploit planning
PROD_CODE_MODEL="muse-wonder-1.0"         # Muse Wonder: patch drafting
PROD_FAST_MODEL="muse-spark-1.3"          # Muse Spark: discovery
PROD_VISION_MODEL="sam-3.1"               # SAM 3.1
PROD_IMAGE_MODEL="muse-image-1.0"         # Muse Image

# Global Model Options
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# Scanner Binary Paths (Auto-detected if in standard PATH)
GITLEAKS_PATH="/opt/homebrew/bin/gitleaks"
SEMGREP_PATH="/opt/homebrew/bin/semgrep"
OSV_SCANNER_PATH="/opt/homebrew/bin/osv-scanner"

# Investigation Limits
MAX_GRAPH_STEPS=12
MAX_TOOL_CALLS=10
PER_TOOL_TIMEOUT_SECONDS=45
MAX_INVESTIGATION_DURATION_SECONDS=300

# Where repositories cloned via "Clone & Scan" are stored (default: ~/.sentinelos/repos)
CLONE_ROOT=""

# Security Token
LOCAL_API_SECRET="sentinel-local-dev-token"
