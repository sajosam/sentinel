# SentinelOS Environment Configuration

# Server Settings
APP_NAME="SentinelOS Security Service"
ENV="development"
HOST="127.0.0.1"
PORT=8000
DATABASE_URL="sqlite:///./sentinel.db"

# Deployment Mode: "demo" (Groq inference) vs "prod" (Meta Model API)
DEPLOY_ENV="demo"

# 1. Demo Mode Configuration (Groq Llama Inference)
DEMO_MODEL_PROVIDER="groq"
DEMO_MODEL_BASE_URL="https://api.groq.com/openai/v1"
DEMO_MODEL_API_KEY="your_groq_api_key_here"
# or set: GROQ_API_KEY="gsk_..."
DEMO_PLANNING_MODEL="llama-3.3-70b-versatile"
DEMO_REASONING_MODEL="llama-3.3-70b-versatile"
DEMO_CODE_MODEL="llama-3.3-70b-versatile"
DEMO_FAST_MODEL="llama-3.1-8b-instant"

# 2. Production Mode Configuration (Meta Model API & Open Weights)
PROD_MODEL_PROVIDER="meta"
PROD_MODEL_BASE_URL="https://api.meta.ai/v1"
PROD_MODEL_API_KEY="your_meta_model_api_key_here"
# or set: META_API_KEY="..."
PROD_PLANNING_MODEL="muse-spark"          # Meta Muse Spark Series
PROD_REASONING_MODEL="muse-wonder"        # Meta Muse Wonder (ThreatLens)
PROD_CODE_MODEL="muse-code"              # Meta Muse Code (Patch Remediation)
PROD_FAST_MODEL="muse-spark-open"         # Meta Muse Spark Open / Glimmer
PROD_VISION_MODEL="sam-3.1"               # Meta SAM 3.1 & Muse Image

# Global Model Options
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# Scanner Binary Paths (Auto-detected if in standard PATH)
GITLEAKS_PATH="/opt/homebrew/bin/gitleaks"
SEMGREP_PATH="/opt/homebrew/bin/semgrep"
OSV_SCANNER_PATH="/opt/homebrew/bin/osv-scanner"

# Investigation Limits
MAX_GRAPH_STEPS=12
MAX_TOOL_CALLS=10
PER_TOOL_TIMEOUT_SECONDS=45
MAX_INVESTIGATION_DURATION_SECONDS=300

# Security Token
LOCAL_API_SECRET="sentinel-local-dev-token"
